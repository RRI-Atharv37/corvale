{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spndr",
  "version": "0.17.0",
  "identifier": "com.spndr.app",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../../dist/frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "spndr",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https: ipc: http://ipc.localhost; base-uri 'self'; form-action 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 %1"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/RRI-Atharv37/spndr/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2RDU0NEE1M0U4OEExM0MKUldROG9ZZytwVVRWeGxLOEY4Sk1XSnB4VDlWNXZaSVBBVjh1eDBnbjRUL3FTRnBtSmozSkdDVjAK"
    }
  }
}
