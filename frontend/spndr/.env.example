# Backend API base URL (must match backend PORT, default 5000)
VITE_API_URL=http://localhost:5000/api/v1

# Docs site URL (VitePress dev server, default port 5174 - see docs/)
VITE_DOCS_URL=http://localhost:5174

# Offline local-first sync engine (Phase 13). All dashboard pages now read/write through the
# local store when this is true (13.9); reports/forecast/calendar/subscriptions/debt-plan and
# import/backup stay server-only until 13.10. Defaults to false (online-only) until the full
# phase (through 13.12) has had more real-world mileage.
VITE_LOCAL_FIRST=false
