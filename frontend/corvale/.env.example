# Backend API base URL (must match backend PORT, default 5000)
VITE_API_URL=http://localhost:5000/api/v1

# Same backend, origin only (scheme + host + port, no /api/v1 path) - used only to build the
# connect-src directive in index.html's Content-Security-Policy meta tag (S16, SEC-18). Keep
# this in sync with VITE_API_URL's origin whenever that changes.
VITE_API_ORIGIN=http://localhost:5000

# Docs site URL (VitePress dev server, default port 5174 - see docs/)
VITE_DOCS_URL=http://localhost:5174

# Offline local-first sync engine (Phase 13): local SQLite store, outbox/sync, PIN unlock, and
# local reads/writes on every dashboard page. Left false for the web build by design - offline
# data is a desktop feature, enabled only via .env.desktop (the Tauri build). Leave this false
# for a browser deployment.
VITE_LOCAL_FIRST=false

# EC (P-256) public key, PEM-encoded with real newlines replaced by literal \n, matching the
# backend's OFFLINE_GRANT_PRIVATE_KEY (S16, SEC-18). Verifies the signed offline session grant
# locally so a device can keep rendering its cached data while offline. Required - without it,
# offline rendering fails closed (no cached-user fallback) rather than trusting an unsigned
# grant. Generate alongside the backend key:
#   openssl ecparam -genkey -name prime256v1 -noout -out offline-grant-private.pem
#   openssl ec -in offline-grant-private.pem -pubout -out offline-grant-public.pem
VITE_OFFLINE_GRANT_PUBLIC_KEY=replace-with-your-own-ES256-public-key-pem-newlines-escaped-as-\n

# CAPTCHA on signup (L9 abuse controls). Must match the backend's CAPTCHA_ENABLED - this only
# controls whether Signup.tsx renders the hCaptcha widget and sends captchaToken; the backend
# is what actually enforces it. Defaults to false (matches today's behavior byte-for-byte,
# including the CSP - see vite.config.ts's captchaCspPlugin, which only widens script-src/
# style-src/connect-src/frame-src to admit hCaptcha's origins when this is true).
VITE_CAPTCHA_ENABLED=false

# hCaptcha *site* key (public, safe to ship in the bundle) - pairs with the backend's
# CAPTCHA_SECRET_KEY. Only read when VITE_CAPTCHA_ENABLED=true.
VITE_CAPTCHA_SITE_KEY=
