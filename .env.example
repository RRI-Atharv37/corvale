# Copy to `.env` and fill in real values before running `docker compose build`/`up`.
# docker-compose.yml reads this file automatically (it's next to it) to fill in the frontend
# image's *build-time* args — Vite bakes VITE_* variables into the compiled JS, so they must
# be correct before the build, not set afterward as container environment variables.
#
# This file is only consumed by docker-compose.yml. backend/.env and frontend/corvale/.env are
# still the source of truth for running the app outside Docker — see
# docs/developers/environment-variables.md.

# Backend API base URL as reachable from a user's browser. Change the host/port if you're
# putting a reverse proxy or a real domain in front of the containers.
VITE_API_URL=http://localhost:5000/api/v1

# Same backend, origin only (no /api/v1 path) - keep this in sync with VITE_API_URL's origin.
VITE_API_ORIGIN=http://localhost:5000

# EC (P-256) public key matching the backend's OFFLINE_GRANT_PRIVATE_KEY (see backend/.env).
# Required for the offline session grant to verify - see environment-variables.md.
VITE_OFFLINE_GRANT_PUBLIC_KEY=

# Optional: URL of a separately hosted docs site. Leave unset to hide the in-app Docs link.
VITE_DOCS_URL=

# Optional hCaptcha signup widget - must match backend/.env's CAPTCHA_ENABLED.
VITE_CAPTCHA_ENABLED=false
VITE_CAPTCHA_SITE_KEY=
