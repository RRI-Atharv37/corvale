{
  "name": "spndr-backend",
  "version": "1.0.0",
  "description": "simple expense tracker",
  "homepage": "https://github.com/RRI-Atharv37/spndr#readme",
  "bugs": {
    "url": "https://github.com/RRI-Atharv37/spndr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RRI-Atharv37/spndr.git"
  },
  "license": "Apache-2.0",
  "author": "Atharv Dewangan",
  "type": "commonjs",
  "main": "server.ts",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node ../dist/backend/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:transactions": "ts-node scripts/migrateIncomeExpenseToTransactions.ts",
    "migrate:transactions:dry-run": "ts-node scripts/migrateIncomeExpenseToTransactions.ts --dry-run",
    "migrate:email-verification": "ts-node scripts/backfillEmailVerification.ts",
    "migrate:email-verification:dry-run": "ts-node scripts/backfillEmailVerification.ts --dry-run",
    "purge:tombstones": "ts-node scripts/purgeTombstones.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^7.0.13",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
