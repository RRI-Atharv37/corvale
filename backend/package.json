{
  "name": "corvale-backend",
  "version": "1.0.0",
  "description": "simple expense tracker",
  "homepage": "https://github.com/RRI-Atharv37/corvale#readme",
  "bugs": {
    "url": "https://github.com/RRI-Atharv37/corvale/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RRI-Atharv37/corvale.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Atharv Dewangan",
  "type": "commonjs",
  "main": "server.ts",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "postbuild": "node scripts/linkDistNodeModules.js",
    "start": "node ../dist/backend/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:transactions": "ts-node scripts/migrateIncomeExpenseToTransactions.ts",
    "migrate:transactions:dry-run": "ts-node scripts/migrateIncomeExpenseToTransactions.ts --dry-run",
    "migrate:email-verification": "ts-node scripts/backfillEmailVerification.ts",
    "migrate:email-verification:dry-run": "ts-node scripts/backfillEmailVerification.ts --dry-run",
    "migrate:account-balances": "ts-node scripts/migrateAccountBalancesToMinorUnits.ts",
    "migrate:account-balances:dry-run": "ts-node scripts/migrateAccountBalancesToMinorUnits.ts --dry-run",
    "purge:tombstones": "ts-node scripts/purgeTombstones.ts",
    "purge:tombstones:dry-run": "ts-node scripts/purgeTombstones.ts --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.6",
    "pdfkit": "^0.20.1",
    "@sentry/node": "^10.72.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
