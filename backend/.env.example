# Copy this file to `.env` and fill in real values. Never commit `.env` — it's gitignored.
# Full reference: docs/developers/environment-variables.md

# --- Required (server refuses to start without these — see utils/envValidation.ts, SEC-12) ---

# MongoDB connection string. For a non-Docker run this is the whole story. The Docker Compose
# stack overrides this with an authenticated URI built from the repo-root `.env`'s
# MONGO_ROOT_USERNAME / MONGO_ROOT_PASSWORD (the bundled `mongo` service enables auth — SEC-37),
# so leave this value as-is when deploying with docker-compose.yml.
MONGO_URI=mongodb://127.0.0.1:27017/corvale

# Secret used to sign/verify JWT access tokens. Use a long, random, unique value —
# never reuse this sample. The server refuses to start if JWT_SECRET is left at this
# placeholder (or another well-known weak value), and requires >= 32 chars when
# NODE_ENV=production (SEC-27). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# Access token expiry (jsonwebtoken format, e.g. 15m, 1h). Leaving this unset previously
# issued non-expiring tokens (SEC-12) — it is now a hard startup requirement.
JWT_EXPIRY=15m

# Frontend origin CORS is locked to (e.g. http://localhost:5173 in dev, your production
# frontend URL in prod). Also used to build password-reset/verification email links.
CLIENT_URL=http://localhost:5173

# EC (P-256) private key, PEM-encoded, that signs the client's offline session grant (S16,
# SEC-18) - a JWT the client verifies locally with the matching public key
# (VITE_OFFLINE_GRANT_PUBLIC_KEY in frontend/corvale/.env) but can never mint or extend itself.
# Generate a fresh keypair per deployment, never reuse the sample below:
#   openssl ecparam -genkey -name prime256v1 -noout -out offline-grant-private.pem
#   openssl ec -in offline-grant-private.pem -pubout -out offline-grant-public.pem
# Then paste each PEM's contents here with real newlines replaced by literal \n (the value
# must stay on one line).
OFFLINE_GRANT_PRIVATE_KEY=replace-with-your-own-ES256-private-key-pem-newlines-escaped-as-\n

# How many days a client may render its cached data while offline before the signed grant
# above expires and it must reach the server again to renew it.
OFFLINE_GRANT_DAYS=30

# --- Server ---

# HTTP port the API listens on.
PORT=5000

# development | production | test. Controls stack traces in error responses, reset-link
# console logging, and secure-cookie flags. Always "production" in a real deployment.
NODE_ENV=development

# Express `trust proxy` setting — the number of hops (e.g. 1) behind a reverse proxy/load
# balancer, so rate limiters key on the real client IP instead of the proxy's. Leave unset
# (false) when the API is reachable directly.
TRUST_PROXY=

# --- Auth / sessions ---

# Refresh token expiry (jsonwebtoken format).
JWT_REFRESH_EXPIRY=7d

# httpOnly cookie name the refresh token is stored under.
REFRESH_TOKEN_COOKIE_NAME=corvale_refresh

# lax | strict | none. Corvale's pinned topology is same-site deployment (frontend + API on
# one registrable domain) — leave this unset (defaults to "lax"). Only set to "none" for a
# genuinely cross-site deployment, and only alongside NODE_ENV=production (SameSite=None
# cookies must be Secure or browsers reject them). See docs/developers/environment-variables.md
# "Deployment topology" (SEC-11) before changing this.
REFRESH_COOKIE_SAME_SITE=

# --- Password reset / email verification ---

# How long a password-reset token stays valid, in milliseconds (default: 10 minutes).
PASSWORD_RESET_EXPIRY_MS=600000

# How long an email-verification token stays valid, in milliseconds (default: 10 minutes).
# Login is hard-blocked until the address is verified (V9); a blocked user gets a fresh link
# from the unauthenticated POST /auth/email-verification/resend.
EMAIL_VERIFICATION_EXPIRY_MS=600000

# How long an account that never verifies its email is kept before a TTL index removes it and
# releases the address (default: 7 days). Stops an attacker permanently squatting a victim's
# email by pre-registering it. Verified accounts are never affected (SEC-32).
UNVERIFIED_ACCOUNT_TTL_SECONDS=604800

# --- SMTP (password reset + email verification delivery) ---
# Leave SMTP_HOST unset in dev to log reset/verification links to the console instead of
# sending real email. Setting it switches on real delivery — only do that once the sending
# domain's SPF/DKIM/DMARC DNS records are published and verified (V9).
#
# Resend (current provider): SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend,
# SMTP_PASS=<re_… "Sending access" API key>, SMTP_FROM="Corvale <no-reply@send.corvale.app>".

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# "From" address on outgoing mail. Its domain must be the verified sending domain, or DKIM
# won't align. Defaults to "Corvale <no-reply@send.corvale.app>" if unset.
SMTP_FROM=
# "Reply-To" on outgoing mail — a real, monitored inbox, since SMTP_FROM is a no-reply
# mailbox. Defaults to "Corvale Support <support@corvale.app>" if unset.
SMTP_REPLY_TO=

# --- Receipt storage (L3, SEC-23) ---
# Leave RECEIPT_STORAGE_DRIVER unset in dev to keep receipts on local disk under
# uploads/receipts/ (fine for local development, NOT for a hosted deployment - that
# filesystem is destroyed on every deploy). Set to "s3" to upload/serve/delete receipts
# through an S3-compatible bucket instead, with server-side encryption and short-lived
# presigned download URLs.

RECEIPT_STORAGE_DRIVER=
RECEIPT_S3_BUCKET=
RECEIPT_S3_REGION=us-east-1
# Leave unset for real AWS S3; set for an S3-compatible provider (R2, MinIO, Backblaze B2).
RECEIPT_S3_ENDPOINT=
# Set to "true" for providers that require path-style requests (e.g. MinIO).
RECEIPT_S3_FORCE_PATH_STYLE=
RECEIPT_S3_ACCESS_KEY_ID=
RECEIPT_S3_SECRET_ACCESS_KEY=

# Per-user cap on total receipt bytes, enforced at upload under either storage driver.
# Leave unset for no quota.
RECEIPT_STORAGE_QUOTA_BYTES=

# --- Rate limiting ---

# Auth routes (register/login/password-reset) and /auth/refresh + /auth/logout.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# POST /sync/push specifically.
SYNC_PUSH_RATE_LIMIT_WINDOW_MS=60000
SYNC_PUSH_RATE_LIMIT_MAX=120

# POST /workspaces/:id/members (invitations). Its own budget because the endpoint reveals
# whether an email has an account — a dedicated limiter caps bulk enumeration (SEC-32).
WORKSPACE_INVITE_RATE_LIMIT_WINDOW_MS=900000
WORKSPACE_INVITE_RATE_LIMIT_MAX=30

# Every mutating request (POST/PUT/PATCH/DELETE) across the whole API.
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=300

# --- Sync ledger retention ---
# How long a SyncOperation idempotency-ledger row is kept before a TTL index removes it
# (default: 30 days). Only needs to outlive a client's retry window (SEC-33).
SYNC_OPERATION_TTL_SECONDS=2592000

# --- Receipt virus scanning (ClamAV) ---
# Off by default (safe for local dev without a ClamAV daemon running). Set
# VIRUS_SCAN_ENABLED=true and run ClamAV in production.

VIRUS_SCAN_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
# Whether a scan error (not an infected result) rejects the upload. Already defaults to
# fail-closed (true) unless explicitly set to the literal string "false" — set that only if
# you deliberately want uploads to succeed when ClamAV is unreachable.
VIRUS_SCAN_FAIL_CLOSED=

# --- Backup restore zip-bomb protection (S15) ---
# Bounds read from the archive's central directory before any entry is inflated. Defaults
# below are generous enough for normal exports; lower them if disk/memory is constrained.
BACKUP_MAX_UNCOMPRESSED_BYTES=209715200
BACKUP_MAX_ZIP_ENTRIES=10000
BACKUP_MAX_COMPRESSION_RATIO=100

# --- Observability (L4) ---
# Leave SENTRY_DSN unset in dev — error tracking stays a no-op and only the structured JSON
# request/error logs on stdout/stderr are produced. Set it in production to report 5xx errors
# to Sentry (or any Sentry-compatible ingest endpoint). See
# docs/developers/environment-variables.md "Monitoring" for uptime-monitor setup, which needs
# no env var — it just polls the existing GET /health and GET /ready endpoints.

SENTRY_DSN=
# Defaults to NODE_ENV if unset.
SENTRY_ENVIRONMENT=
