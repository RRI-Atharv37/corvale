Authorization: Bearer {{token}}

###
# Expense: download CSV
GET {{baseUrl}}/expense/download
Authorization: Bearer {{token}}

###
# Expense error: missing required fields
POST {{baseUrl}}/expense/create
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Incomplete expense"
}

###
# Expense error: invalid amount or date
POST {{baseUrl}}/expense/create
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Bad expense",
  "amount": "abc",
  "category": "Food",
  "date": "invalid-date"
}

###
# Expense error: not found
GET {{baseUrl}}/expense/000000000000000000000000
Authorization: Bearer {{token}}

###
# Expense error: search without keyword
GET {{baseUrl}}/expense/search
Authorization: Bearer {{token}}

###
# Expense error: filter without dates
GET {{baseUrl}}/expense/filter
Authorization: Bearer {{token}}

###
# Expense error: report without dates
GET {{baseUrl}}/expense/report
Authorization: Bearer {{token}}

###
# Expense error: invalid pagination
GET {{baseUrl}}/expense?page=0&limit=-1
Authorization: Bearer {{token}}

###############################################################################
# SAVER
# add requires: remainingBalance
# optional: percentage (default 30), customPercentage, customAmount
# withdraw requires: amount
###############################################################################

###
# Saver: add using default percentage (30% of remaining balance)
POST {{baseUrl}}/saver/add
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "remainingBalance": 10000
}

###
# Saver: add with custom percentage
POST {{baseUrl}}/saver/add
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "remainingBalance": 10000,
  "percentage": 25
}

###
# Saver: add with customPercentage override
POST {{baseUrl}}/saver/add
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "remainingBalance": 10000,
  "customPercentage": 40
}

###
# Saver: add with explicit customAmount
POST {{baseUrl}}/saver/add
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "remainingBalance": 10000,
  "customAmount": 1500
}

###
# Saver: details
GET {{baseUrl}}/saver/details
Authorization: Bearer {{token}}

###
# Saver: withdraw
POST {{baseUrl}}/saver/withdraw
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "amount": 300
}

###
# Saver error: missing remainingBalance
POST {{baseUrl}}/saver/add
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "percentage": 30
}

###
# Saver error: amount exceeds remaining balance
POST {{baseUrl}}/saver/add
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "remainingBalance": 1000,
  "customAmount": 5000
}

###
# Saver error: invalid percentage
POST {{baseUrl}}/saver/add
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "remainingBalance": 1000,
  "customPercentage": 150
}

###
# Saver error: withdraw more than balance
POST {{baseUrl}}/saver/withdraw
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "amount": 999999
}

###
# Saver error: invalid withdraw amount
POST {{baseUrl}}/saver/withdraw
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "amount": 0
}

###############################################################################
# PUSHOVER
# Moves current saver balance to pushover record and resets saver to 0
###############################################################################

###
# Pushover: move saver balance to next month
POST {{baseUrl}}/pushover/pushover
Authorization: Bearer {{token}}

###
# Pushover error: no saver account (run after pushover if saver was reset and not re-added)
# POST {{baseUrl}}/pushover/pushover
# Authorization: Bearer {{token}}

